# Copy this file to .env.local and put your key in it.
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# .env.local is listed in .gitignore and must never be committed (ground rule 08:
# keep credentials and private information outside the submission).
#
# You do NOT need a key to reproduce this project's results. Run `python verify.py`
# for the full offline check, including replay scoring of the committed traces.

ANTHROPIC_API_KEY=

# Optional. Leave blank to use https://api.anthropic.com.
# A key set in this file is only ever sent to api.anthropic.com unless you name a
# different endpoint here on purpose -- see resolve_credential() in clearqueue/llm.py.
ANTHROPIC_BASE_URL=
